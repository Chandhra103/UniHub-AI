# Local development only. These database credentials are not for production.
MYSQL_DATABASE=unihub
MYSQL_USER=unihub
MYSQL_PASSWORD=local-unihub-only
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_PORT=3306

# Real Manus OAuth values are required for sign-in. Never commit actual values.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Optional comma-separated addresses allowed to bootstrap administrator accounts.
UNIHUB_ADMIN_EMAILS=
